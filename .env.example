APP_ENV=development
PORT=8080

# Replace YOUR_LOCAL_USERNAME (never hardcode it in source)
DATABASE_URL=postgresql://YOUR_LOCAL_USERNAME@localhost:5432/migo?sslmode=disable

# Generate with: openssl rand -hex 32   (must be >= 32 chars)
ACCESS_TOKEN_SECRET=CHANGE_ME
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Browser origins allowed by CORS, comma-separated (your frontend URL, no path, no "*").
# In development this defaults to http://localhost:3000 and http://localhost:5173.
# In production leave empty for same-origin only, or set e.g. https://app.migo.example
# FRONTEND_URL=http://localhost:3000

# Reverse proxies whose X-Forwarded-For is trusted (IPs or CIDRs, comma-separated).
# Leave EMPTY when the API is reached directly. When behind a load balancer/proxy set
# it to that proxy's address(es), otherwise every client shares the proxy's IP for
# rate limiting. Never list ranges you don't control.
# TRUSTED_PROXIES=10.0.0.0/8

# --- Email (Resend) ---
# In development without a key, emails are LOGGED to the console. Logs include
# live links, so configure Resend or keep these logs private.
# For delivery, create a Resend API key and verify the sender domain in Resend.
# RESEND_API_KEY=re_...
# MAIL_FROM=Verifyflow <no-reply@yourdomain.com>

# Every transactional email shares one black-and-white branded template.
# MAIL_LOGO_URL is optional: until you have a hosted logo image, emails
# render a plain circle with the brand's first letter instead.
MAIL_BRAND_NAME=Verifyflow
# MAIL_LOGO_URL=https://yourdomain.com/logo.png

# Frontend page that receives the reset token. The token is appended as a URL
# fragment (#token=...) so it never reaches servers, proxies or access logs.
# Defaults to the first FRONTEND_URL origin + /reset-password.
# PASSWORD_RESET_URL=http://localhost:3000/reset-password
# Reset link lifetime (5m to 24h).
# PASSWORD_RESET_TTL=30m

# Auth rate limiting (default true).
# RATE_LIMIT_ENABLED=true

# Run migrations on startup. Defaults to true in development, false otherwise.
# AUTO_MIGRATE=true

# Email-verification page and lifetime. Defaults to FRONTEND_URL + /verify-email.
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
EMAIL_VERIFICATION_TTL=24h

# Number reservation lifetime before an unpaid reservation can be released.
RENTAL_RESERVATION_TTL=15m

# How often the rental auto-renewal pass runs (re-bill each active rental
# whose period ended, or release it if the customer's wallet can't cover it).
RENEWAL_INTERVAL=1h

# Paystack redirects the browser here after hosted checkout.
PAYSTACK_CALLBACK_URL=http://localhost:3000/payments/callback

# AES-256 keys used to encrypt provider credentials stored in PostgreSQL.
# Generate one key with: openssl rand -base64 32
# Rotation format: v1:BASE64_KEY,v2:BASE64_KEY
PROVIDER_CREDENTIAL_KEYS=
PROVIDER_CREDENTIAL_KEY_VERSION=

# --- Payment provider credentials ---
# Keep blank until the account is ready. Runtime provider configuration is
# stored encrypted in provider_configs; these variables are staging values
# for a future bootstrap/import command and are never exposed to the frontend.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Vonage ---
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_APPLICATION_PRIVATE_KEY=
VONAGE_SIGNATURE_SECRET=
VONAGE_DEFAULT_COUNTRY=NG

# --- Telnyx ---
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=

# Optional future OAuth login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
